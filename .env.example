# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/unilife

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Socket.IO CORS Configuration
# Hỗ trợ 1 origin hoặc nhiều origin ngăn cách bằng dấu phẩy.
# Ví dụ local:
# SOCKET_ORIGIN=http://localhost:5173,http://localhost:5174
# Dùng "*" chỉ cho môi trường test nội bộ, không khuyến nghị production.
SOCKET_ORIGIN=http://localhost:5173,http://localhost:5174

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Logging Configuration
# Enable detailed request/response logging to files (true/false)
# Note: Morgan HTTP logging is always enabled in console
# Set to 'true' to also log detailed request/response info to winston files
ENABLE_REQUEST_LOGGING=false
