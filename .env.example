# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/unilife

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Logging Configuration
# Enable detailed request/response logging to files (true/false)
# Note: Morgan HTTP logging is always enabled in console
# Set to 'true' to also log detailed request/response info to winston files
ENABLE_REQUEST_LOGGING=false
