@startuml ERD_MODULE_4_STAFF_MANAGEMENT
' =====================================================
' Module 4: Staff Management - Quản lý nhân viên
' Bao gồm: shift, staff_shift, salary
' =====================================================

!define TABLE(name) entity name << (T,#FFAAFF) >>
!define PRIMARY_KEY(x) <b><color:#b8860b><&key></color> x</b>
!define FOREIGN_KEY(x) <color:#aaaaaa><&link-intact></color> x
!define COLUMN(x) <color:#efefef><&media-record></color> x
!define NOT_NULL(x) <u>x</u>

skinparam linetype ortho
skinparam entity {
    BackgroundColor #fff5ff
    BorderColor #333333
    ArrowColor #333333
}

title Module 4: Staff Management - Quản lý nhân viên\n(shift, staff_shift, salary)

' =====================================================
' REFERENCE TABLES (từ Module khác)
' =====================================================
entity user << (R,#CCCCCC) Reference >> {
    PRIMARY_KEY(id) : CHAR(36)
    --
    full_name : VARCHAR(100)
    role : ENUM('admin', 'manager', 'staff', 'customer')
    FOREIGN_KEY(canteen_id) : CHAR(36)
    .. Xem chi tiết tại Module 1 ..
}

entity canteen << (R,#CCCCCC) Reference >> {
    PRIMARY_KEY(id) : CHAR(36)
    --
    name : VARCHAR(100)
    .. Xem chi tiết tại Module 1 ..
}

' =====================================================
' BẢNG SHIFT - Ca làm việc
' =====================================================
TABLE(shift) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(canteen_id) : CHAR(36) <<FK>>
    NOT_NULL(name) : VARCHAR(100)
    NOT_NULL(start_time) : TIME
    NOT_NULL(end_time) : TIME
    day_of_week : JSON
    max_staff : INT
    status : ENUM('active', 'inactive')
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}
note right of shift::day_of_week
  Mảng các ngày trong tuần [0-6]
  VD: [1,2,3,4,5] = Thứ 2-6
end note

' =====================================================
' BẢNG STAFF_SHIFT - Phân công ca cho nhân viên
' =====================================================
TABLE(staff_shift) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(shift_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(staff_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(canteen_id) : CHAR(36) <<FK>>
    NOT_NULL(date) : DATE
    status : ENUM('scheduled', 'checked_in', 'checked_out', 'absent', 'cancelled')
    check_in_time : TIMESTAMP
    check_out_time : TIMESTAMP
    actual_work_hours : DECIMAL(5,2)
    notes : VARCHAR(500)
    FOREIGN_KEY(assigned_by) : CHAR(36) <<FK>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' =====================================================
' BẢNG SALARY - Bảng lương
' =====================================================
TABLE(salary) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(user_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(canteen_id) : CHAR(36) <<FK>>
    NOT_NULL(period_start) : DATE
    NOT_NULL(period_end) : DATE
    total_hours : DECIMAL(10,2)
    NOT_NULL(base_salary) : DECIMAL(15,2)
    bonus : DECIMAL(15,2)
    deduction : DECIMAL(15,2)
    total_salary : DECIMAL(15,2)
    status : ENUM('pending', 'calculated', 'approved', 'paid')
    calculated_at : TIMESTAMP
    paid_at : TIMESTAMP
    note : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' =====================================================
' MỐI QUAN HỆ
' =====================================================

' Canteen - Shift: 1-N (Một canteen có nhiều ca làm việc)
canteen ||--o{ shift : "1-N: định nghĩa"

' Canteen - Staff Shift: 1-N
canteen ||--o{ staff_shift : "1-N: phân công tại"

' Canteen - Salary: 1-N
canteen ||--o{ salary : "1-N: trả lương"

' Shift - Staff Shift: 1-N (Một ca có nhiều phân công)
shift ||--o{ staff_shift : "1-N: được phân công"

' User (Staff) - Staff Shift: 1-N (Một nhân viên có nhiều ca)
user ||--o{ staff_shift : "1-N: làm việc"

' User (Manager) - Staff Shift: 1-N (Người phân công)
user ||--o{ staff_shift : "1-N: phân công (assigned_by)"

' User (Staff) - Salary: 1-N (Một nhân viên có nhiều bản ghi lương)
user ||--o{ salary : "1-N: nhận lương"

' =====================================================
' GHI CHÚ NGHIỆP VỤ
' =====================================================
note bottom of staff_shift
  **Quy trình phân công ca:**
  1. Manager tạo Shift cho canteen
  2. Manager phân công Staff vào Shift (tạo Staff_Shift)
  3. Staff check-in/check-out khi làm việc
  4. Hệ thống tính actual_work_hours
  5. Cuối kỳ tính Salary dựa trên total_hours
end note

note bottom of salary
  **Quy trình tính lương:**
  status: pending → calculated → approved → paid
  
  total_salary = base_salary + bonus - deduction
  
  Tính dựa trên total_hours từ staff_shift
end note

@enduml
