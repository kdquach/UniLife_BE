@startuml Change Password Sequence Diagram
title UC07 - Change Password

actor "User" as User
boundary "Change Password Page" as Frontend
participant ":authRoutes" as Routes
participant ":authMiddleware" as AuthMW
participant ":authController" as Controller
participant ":authService" as Service
participant ":User Model" as UserModel
database ":MongoDB" as DB

activate User
User -> Frontend: 1. Enter old and new password
activate Frontend

Frontend -> Frontend: 2. validateFields()

opt [Validation failed]
    Frontend --> User: 2.1 Display error
end

Frontend -> Routes: 3. PATCH /api/auth/change-password\n(Bearer Token, oldPassword, newPassword)
activate Routes

Routes -> AuthMW: 4. protect(req, res, next)
activate AuthMW

AuthMW -> AuthMW: 5. Verify JWT token

opt [Invalid token]
    AuthMW --> Routes: 5.1 HTTP 401 Response
    Routes --> Frontend: 5.2 JSON Error
    Frontend --> User: 5.3 Redirect to login page
end

AuthMW -> UserModel: 6. findById(decoded.id)
activate UserModel

UserModel -> DB: 7. Query user
activate DB

DB --> UserModel: 8. User document
deactivate DB

UserModel --> AuthMW: 9. User data
deactivate UserModel

AuthMW -> AuthMW: 10. req.user = user

AuthMW --> Routes: 11. next()
deactivate AuthMW

Routes -> Controller: 12. changePassword(req, res)
activate Controller

Controller -> Service: 13. changePassword(userId, oldPassword, newPassword)
activate Service

Service -> UserModel: 14. findById(userId)
activate UserModel

UserModel -> DB: 15. Query user
activate DB

DB --> UserModel: 16. User document
deactivate DB

UserModel --> Service: 17. User data
deactivate UserModel

Service -> Service: 18. Verify oldPassword

opt [Old password incorrect]
    Service --> Controller: 18.1 AppError "Old password is incorrect" 400
    Controller --> Routes: 18.2 HTTP 400 Response
    Routes --> Frontend: 18.3 JSON Error
    Frontend --> User: 18.4 Display error
end

Service -> Service: 19. Hash newPassword

Service -> UserModel: 20. findByIdAndUpdate(userId, {password})
activate UserModel

UserModel -> DB: 21. Update password
activate DB

DB --> UserModel: 22. Updated user
deactivate DB

UserModel --> Service: 23. User data
deactivate UserModel

Service --> Controller: 24. Return success message
deactivate Service

Controller --> Routes: 25. HTTP 200 Response
deactivate Controller

Routes --> Frontend: 26. JSON {message: "Password changed successfully"}
deactivate Routes

Frontend --> User: 27. Display success message
deactivate Frontend
deactivate User
@enduml
