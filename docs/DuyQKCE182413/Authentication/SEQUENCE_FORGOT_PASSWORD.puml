@startuml Forgot Password Sequence Diagram
title UC05 - Forgot Password

actor "User" as User
boundary "Forgot Password Page" as Frontend
participant ":authRoutes" as Routes
participant ":authController" as Controller
participant ":authService" as Service
participant ":User Model" as UserModel
participant ":OTP Model" as OTPModel
participant ":EmailService" as EmailService
database ":MongoDB" as DB

User -> Frontend: 1. Enter email to reset password
activate Frontend

Frontend -> Frontend: 2. validateEmail()

opt [Invalid email]
    Frontend --> User: 2.1 Display error
end

Frontend -> Routes: 3. POST /api/auth/forgot-password\n(email)
activate Routes

Routes -> Controller: 4. forgotPassword(req, res)
activate Controller

Controller -> Service: 5. forgotPassword(email)
activate Service

Service -> UserModel: 6. findOne({email})
activate UserModel

UserModel -> DB: 7. Query user
activate DB

DB --> UserModel: 8. User document or null
deactivate DB

UserModel --> Service: 9. User data
deactivate UserModel

opt [User not found]
    Service --> Controller: 10.1 AppError "Email not found" 404
    deactivate Service
    Controller --> Routes: 10.2 HTTP 404 Response
    deactivate Controller
    Routes --> Frontend: 10.3 JSON Error
    deactivate Routes
    Frontend --> User: 10.4 Display error
end

Service -> Service: 10. Generate OTP (6 digits)

Service -> OTPModel: 11. create({email, otp, expiresAt})
activate OTPModel

OTPModel -> DB: 12. Save OTP
activate DB

DB --> OTPModel: 13. OTP document
deactivate DB

OTPModel --> Service: 14. OTP data
deactivate OTPModel

Service -> EmailService: 15. sendResetPasswordOTP(email, otp)
activate EmailService

EmailService --> Service: 16. Email sent
deactivate EmailService

opt [Send email failed]
    Service --> Controller: 17.1 AppError "Failed to send OTP" 500
    deactivate Service
    Controller --> Routes: 17.2 HTTP 500 Response
    deactivate Controller
    Routes --> Frontend: 17.3 JSON Error
    deactivate Routes
    Frontend --> User: 17.4 Display error
end

Service --> Controller: 17. Return success message
deactivate Service

Controller --> Routes: 18. HTTP 200 Response
deactivate Controller

Routes --> Frontend: 19. JSON {message: "OTP sent successfully"}
deactivate Routes

Frontend --> User: 20. Display OTP and new password form
deactivate Frontend

User -> Frontend: 21. Enter OTP and new password
activate Frontend

Frontend -> Frontend: 22. validateFields()

opt [Validation failed]
    Frontend --> User: 22.1 Display error
end

Frontend -> Routes: 23. POST /api/auth/reset-password\n(email, otp, newPassword)
activate Routes

Routes -> Controller: 24. resetPassword(req, res)
activate Controller

ref over Controller, Service, OTPModel, DB
  Verify OTP Subsequence
end ref

opt [OTP invalid or expired]
    Controller --> Routes: 25.1 HTTP 400 Response
    deactivate Controller
    Routes --> Frontend: 25.2 JSON Error
    deactivate Routes
    Frontend --> User: 25.3 Display error
end

Controller -> Service: 25. updatePassword(email, newPassword)
activate Service

Service -> Service: 26. Hash newPassword

Service -> UserModel: 27. findOneAndUpdate({email}, {password})
activate UserModel

UserModel -> DB: 28. Update password
activate DB

DB --> UserModel: 29. Updated user
deactivate DB

UserModel --> Service: 30. User data
deactivate UserModel

Service --> Controller: 31. Return success message
deactivate Service

Controller --> Routes: 32. HTTP 200 Response
deactivate Controller

Routes --> Frontend: 33. JSON {message: "Password changed successfully"}
deactivate Routes

Frontend --> User: 34. Display message and redirect to login page
deactivate Frontend

@enduml
