@startuml View Ingredient Category Detail Sequence Diagram
title UC06 - View Ingredient Category Detail (Xem chi tiết nhóm nguyên liệu)

actor "Staff/Manager" as User
participant "Ingredient\nCategories Page" as Frontend
participant "ingredientRoutes" as Routes
participant "authMiddleware" as AuthMW
participant "ingredientController" as Controller
participant "ingredientService" as Service
participant "IngredientCategory\nModel" as Model
database "MongoDB" as DB

== User đang xem danh sách ==
User -> Frontend: 1. Click nút "Xem"\ntrên một category
activate Frontend

Frontend -> Frontend: 2. handleViewDetail(record)\nđược gọi

== Lấy chi tiết ingredient category ==
Frontend -> Routes: 3. GET /api/ingredient-categories/:id\n(Bearer Token)
activate Routes

Routes -> AuthMW: 4. Verify JWT token
activate AuthMW

AuthMW -> AuthMW: 5. Extract user info\nfrom token

alt Token không hợp lệ
    AuthMW --> Routes: 6a. 401 Unauthorized
    Routes --> Frontend: HTTP 401 Response
    Frontend -> Frontend: Show error message:\n"Không thể tải chi tiết"
    Frontend --> User: Hiển thị thông báo lỗi
else Token hợp lệ
    AuthMW -> Routes: 6b. req.user = decoded\n(userId, canteenId, role)
    deactivate AuthMW
    
    Routes -> Controller: 7. getIngredientCategoryById\n(req, res)
    activate Controller
    
    Controller -> Controller: 8. Extract:\n- categoryId từ req.params.id\n- canteenId từ req.user
    
    Controller -> Service: 9. getIngredientCategoryById\n(categoryId, canteenId)
    activate Service
    
    Service -> Service: 10. Build filter:\n{\n  _id: categoryId,\n  canteenId: canteenId\n}
    
    Service -> Model: 11. findOne(filter)
    activate Model
    
    Model -> DB: 12. Query:\ndb.ingredientcategories.findOne({\n  _id: ObjectId(categoryId),\n  canteenId: ObjectId(canteenId)\n})
    activate DB
    
    alt Category không tồn tại hoặc không thuộc canteen
        DB --> Model: 13a. Return null
        deactivate DB
        
        Model --> Service: null
        deactivate Model
        
        Service -> Service: throw AppError(\n"Ingredient category not found",\n404)
        
        Service --> Controller: Error: 404 Not Found
        deactivate Service
        
        Controller --> Routes: HTTP 404 Response:\n{\n  success: false,\n  message: "Not found"\n}
        deactivate Controller
        
        Routes --> Frontend: JSON Error Response
        deactivate Routes
        
        Frontend -> Frontend: Catch error và\nshow message
        
        Frontend --> User: Hiển thị:\n"Không tìm thấy\nhoặc không có quyền truy cập"
        
    else Category tồn tại và thuộc canteen
        DB --> Model: 13b. Return category document:\n{\n  _id: "xxx",\n  name: "Gia vị",\n  description: "...",\n  canteenId: "yyy",\n  isActive: true,\n  createdAt: "...",\n  updatedAt: "..."\n}
        deactivate DB
        
        Model --> Service: 14. Return category object
        deactivate Model
        
        Service --> Controller: 15. Return category
        deactivate Service
        
        Controller -> Controller: 16. Format response:\n{\n  success: true,\n  message: "Lấy chi tiết\n  nhóm nguyên liệu thành công",\n  data: category\n}
        
        Controller --> Routes: 17. HTTP 200 Response
        deactivate Controller
        
        Routes --> Frontend: 18. JSON Response
        deactivate Routes
        
        Frontend -> Frontend: 19. setState:\n- selected = response.data\n- detailOpen = true
        
        Frontend -> Frontend: 20. Render Modal\nvới thông tin:\n- Tên nhóm\n- Mô tả\n- Trạng thái (Active tag)\n- Ngày tạo\n- Ngày cập nhật
        
        Frontend --> User: 21. Hiển thị Modal\nvới chi tiết category
    end
end

deactivate Frontend

== User đóng modal ==
User -> Frontend: 22. Click nút "Đóng"\nhoặc click outside
activate Frontend

Frontend -> Frontend: 23. setState:\ndetailOpen = false

Frontend --> User: 24. Đóng modal,\nquay về danh sách
deactivate Frontend

@enduml
