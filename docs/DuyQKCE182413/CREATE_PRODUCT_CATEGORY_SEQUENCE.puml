@startuml Create Product Category Sequence Diagram
title UC11 - Create Product Category (Tạo danh mục sản phẩm)

actor "Staff/Manager" as User
participant "Product\nCategories Page" as Frontend
participant "productRoutes" as Routes
participant "authMiddleware" as AuthMW
participant "productController" as Controller
participant "productService" as Service
participant "ProductCategory\nModel" as Model
database "MongoDB" as DB

== User mở form tạo mới ==
User -> Frontend: 1. Click nút "Thêm danh mục"
activate Frontend

Frontend -> Frontend: 2. handleCreate()\n- formMode = "create"\n- form.resetFields()\n- formOpen = true\n- initialValues: {isActive: true}

Frontend --> User: 3. Hiển thị Modal\nvới form:\n- Tên danh mục*\n- Mô tả\n- Trạng thái (Switch)
deactivate Frontend

== User nhập thông tin và submit ==
User -> Frontend: 4. Nhập:\n- Tên: "Bún"\n- Mô tả: "Các món bún"\n- isActive: true\nClick "Tạo mới"
activate Frontend

Frontend -> Frontend: 5. form.validateFields()

opt Validation failed
    Frontend -> Frontend: 6a. Show validation errors\n(VD: Tên ít nhất 2 ký tự)
    Frontend --> User: Hiển thị lỗi validation
end

Frontend -> Routes: 6. POST /api/product-categories\nBody: {\n  name: "Bún",\n  description: "Các món bún",\n  isActive: true\n}\n(Bearer Token)
    activate Routes
    
    Routes -> AuthMW: 7. Verify JWT token
    activate AuthMW
    
    AuthMW -> AuthMW: 8. Extract user info\nfrom token
    
    opt Token không hợp lệ
        AuthMW --> Routes: 9a. 401 Unauthorized
        Routes --> Frontend: HTTP 401 Response
        Frontend --> User: Redirect to Login
    end
    
    AuthMW -> Routes: 9. req.user = decoded\n(userId, canteenId, role)
    deactivate AuthMW
        
        Routes -> Controller: 10. createProductCategory\n(req, res)
        activate Controller
        
        Controller -> Controller: 11. Extract canteenId\nfrom req.user
        
        opt User không có canteenId
            Controller -> Controller: 12a. throw AppError(\n"User không được gán\nvào canteen nào", 400)
            
            Controller --> Routes: HTTP 400 Response
            deactivate Controller
            Routes --> Frontend: JSON Error Response
            deactivate Routes
            Frontend --> User: Show error message
        end
        
        Controller -> Controller: 12. Merge data:\n{\n  ...req.body,\n  canteenId: canteenId\n}
            
            Controller -> Service: 13. createProductCategory(data)
            activate Service
            
            Service -> Model: 14. findOne({\n  canteenId: canteenId,\n  name: {$regex: /^Bún$/i}\n})
            activate Model
            
            Model -> DB: 15. Check duplicate name\ntrong cùng canteen\n(case-insensitive)
            activate DB
            
            opt Tên đã tồn tại
                DB --> Model: 16a. Return existing category
                deactivate DB
                
                Model --> Service: existing category
                deactivate Model
                
                Service -> Service: throw AppError(\n"Danh mục sản phẩm 'Bún'\nđã tồn tại trong canteen này",\n400)
                
                Service --> Controller: Error: 400 Bad Request
                deactivate Service
                
                Controller --> Routes: HTTP 400 Response:\n{\n  success: false,\n  message: "...đã tồn tại..."\n}
                deactivate Controller
                
                Routes --> Frontend: JSON Error Response
                deactivate Routes
                
                Frontend -> Frontend: Show error message:\n"Danh mục đã tồn tại"
                
                Frontend --> User: Form vẫn mở,\nhiển thị lỗi
            end
            
            DB --> Model: 16. Return null
            deactivate DB
            
            Model --> Service: null (không trùng)
            deactivate Model
            
            Service -> Model: 17. create({\n  name: "Bún",\n  description: "Các món bún",\n  canteenId: "xxx",\n  isActive: true\n})
                activate Model
                
                Model -> DB: 18. Insert new document\nvới auto timestamps
                activate DB
                
                DB --> Model: 19. Return new category\nvới _id, createdAt, updatedAt
                deactivate DB
                
                Model --> Service: 20. Return category object
                deactivate Model
                
                Service --> Controller: 21. Return category
                deactivate Service
                
                Controller -> Controller: 22. Format response:\n{\n  success: true,\n  message: "Tạo danh mục\n  sản phẩm thành công",\n  data: category\n}
                
                Controller --> Routes: 23. HTTP 201 Created
                deactivate Controller
                
                Routes --> Frontend: 24. JSON Response
                deactivate Routes
                
                Frontend -> Frontend: 25. setState:\n- formOpen = false\n- form.resetFields()\n- Show success notification
                
                Frontend -> Frontend: 26. fetchList(page=1, pageSize)\n(reload danh sách)
                
                Frontend --> User: 27. Hiển thị thông báo:\n"Tạo danh mục thành công"\nModal đóng,\ndanh sách cập nhật\nvới item mới

deactivate Frontend

@enduml
