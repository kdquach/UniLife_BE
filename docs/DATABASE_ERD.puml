@startuml UniLife_Database_ERD
!define TABLE(name) entity name << (T,#FFAAAA) >>
!define PK(x) <b><color:#b8860b>x</color></b>
!define FK(x) <color:#007ACC>x</color>

title UniLife Database - Entity Relationship Diagram
skinparam backgroundColor #FEFEFE
skinparam linetype ortho

' =====================================================
' CAMPUS & CANTEEN
' =====================================================
TABLE(campus) {
    PK(id) : CHAR(36)
    --
    name : VARCHAR(255) <<UNIQUE>>
    code : VARCHAR(10) <<UNIQUE>>
    address : TEXT
    status : ENUM
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

TABLE(canteen) {
    PK(id) : CHAR(36)
    --
    FK(campus_id) : CHAR(36)
    name : VARCHAR(100)
    location : VARCHAR(255)
    status : ENUM
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' =====================================================
' USER & AUTHENTICATION
' =====================================================
TABLE(user) {
    PK(id) : CHAR(36)
    --
    email : VARCHAR(255) <<UNIQUE>>
    password : VARCHAR(255)
    full_name : VARCHAR(100)
    phone : VARCHAR(15)
    gender : ENUM
    avatar : VARCHAR(500)
    date_of_birth : DATE
    address : VARCHAR(500)
    balance : DECIMAL(15,2)
    role : ENUM
    status : ENUM
    provider : ENUM
    provider_id : VARCHAR(255)
    email_verified : BOOLEAN
    email_verified_at : TIMESTAMP
    last_login_at : TIMESTAMP
    FK(campus_id) : CHAR(36)
    FK(canteen_id) : CHAR(36)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

TABLE(token) {
    PK(id) : CHAR(36)
    --
    FK(user_id) : CHAR(36)
    token : VARCHAR(500) <<UNIQUE>>
    type : ENUM
    expires_at : TIMESTAMP
    created_at : TIMESTAMP
}

TABLE(otp) {
    PK(id) : CHAR(36)
    --
    email : VARCHAR(255)
    otp : VARCHAR(10)
    type : ENUM
    expires_at : TIMESTAMP
    verified : BOOLEAN
    attempts : INT
    created_at : TIMESTAMP
}

' =====================================================
' PRODUCT & CATEGORY
' =====================================================
TABLE(product_category) {
    PK(id) : CHAR(36)
    --
    name : VARCHAR(100) <<UNIQUE>>
    description : VARCHAR(500)
    icon : VARCHAR(255)
    is_active : BOOLEAN
    created_at : TIMESTAMP
}

TABLE(ingredient_category) {
    PK(id) : CHAR(36)
    --
    name : VARCHAR(100) <<UNIQUE>>
    description : VARCHAR(500)
    icon : VARCHAR(255)
    is_active : BOOLEAN
    created_at : TIMESTAMP
}

TABLE(ingredient) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    FK(category_id) : CHAR(36)
    name : VARCHAR(100)
    stock : DECIMAL(15,2)
    unit : VARCHAR(50)
    created_at : TIMESTAMP
}

TABLE(product) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    FK(category_id) : CHAR(36)
    name : VARCHAR(200)
    slug : VARCHAR(250)
    price : DECIMAL(15,2)
    original_price : DECIMAL(15,2)
    status : ENUM
    description : TEXT
    image : VARCHAR(500)
    calories : INT
    preparation_time : INT
    is_popular : BOOLEAN
    is_new : BOOLEAN
    stock_quantity : INT
    low_stock_threshold : INT
    total_sold : INT
    rating_average : DECIMAL(3,2)
    rating_count : INT
    display_order : INT
    created_at : TIMESTAMP
}

TABLE(product_image) {
    PK(id) : CHAR(36)
    --
    FK(product_id) : CHAR(36)
    image_url : VARCHAR(500)
    display_order : INT
    created_at : TIMESTAMP
}

TABLE(recipe) {
    PK(id) : CHAR(36)
    --
    FK(product_id) : CHAR(36)
    FK(ingredient_id) : CHAR(36)
    quantity : DECIMAL(10,2)
    unit : VARCHAR(50)
    description : VARCHAR(200)
    created_at : TIMESTAMP
}

' =====================================================
' MENU
' =====================================================
TABLE(menu) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    date : DATE
    status : ENUM
    created_at : TIMESTAMP
}

TABLE(menu_item) {
    PK(id) : CHAR(36)
    --
    FK(menu_id) : CHAR(36)
    FK(product_id) : CHAR(36)
    display_order : INT
    created_at : TIMESTAMP
}

' =====================================================
' VOUCHER
' =====================================================
TABLE(voucher) {
    PK(id) : CHAR(36)
    --
    code : VARCHAR(20) <<UNIQUE>>
    discount_type : ENUM
    value : DECIMAL(15,2)
    min_order_amount : DECIMAL(15,2)
    max_discount : DECIMAL(15,2)
    max_usage : INT
    used_count : INT
    start_date : DATETIME
    end_date : DATETIME
    is_active : BOOLEAN
    FK(campus_id) : CHAR(36)
    user_usage_limit : INT
    apply_to : ENUM
    description : VARCHAR(500)
    created_at : TIMESTAMP
}

TABLE(voucher_product) {
    PK(id) : CHAR(36)
    --
    FK(voucher_id) : CHAR(36)
    FK(product_id) : CHAR(36)
    created_at : TIMESTAMP
}

' =====================================================
' CART & WISHLIST
' =====================================================
TABLE(cart) {
    PK(id) : CHAR(36)
    --
    FK(user_id) : CHAR(36)
    FK(canteen_id) : CHAR(36)
    total_price : DECIMAL(15,2)
    created_at : TIMESTAMP
}

TABLE(cart_item) {
    PK(id) : CHAR(36)
    --
    FK(cart_id) : CHAR(36)
    FK(product_id) : CHAR(36)
    quantity : INT
    created_at : TIMESTAMP
}

TABLE(wishlist) {
    PK(id) : CHAR(36)
    --
    FK(user_id) : CHAR(36) <<UNIQUE>>
    created_at : TIMESTAMP
}

TABLE(wishlist_item) {
    PK(id) : CHAR(36)
    --
    FK(wishlist_id) : CHAR(36)
    FK(product_id) : CHAR(36)
    created_at : TIMESTAMP
}

' =====================================================
' ORDER
' =====================================================
TABLE(order) {
    PK(id) : CHAR(36)
    --
    order_number : VARCHAR(50) <<UNIQUE>>
    FK(user_id) : CHAR(36)
    FK(canteen_id) : CHAR(36)
    FK(staff_id) : CHAR(36)
    status : ENUM
    sub_total : DECIMAL(15,2)
    discount : DECIMAL(15,2)
    total_amount : DECIMAL(15,2)
    FK(voucher_id) : CHAR(36)
    voucher_code : VARCHAR(20)
    payment_method : ENUM
    payment_status : ENUM
    payment_transaction_id : VARCHAR(100)
    payment_amount : DECIMAL(15,2)
    paid_at : TIMESTAMP
    refund_amount : DECIMAL(15,2)
    pickup_qr_code : VARCHAR(100)
    pickup_qr_expire_at : TIMESTAMP
    pickup_qr_scanned_at : TIMESTAMP
    FK(pickup_qr_scanned_by) : CHAR(36)
    note : VARCHAR(500)
    estimated_time : INT
    prepared_at : TIMESTAMP
    completed_at : TIMESTAMP
    cancelled_at : TIMESTAMP
    cancel_reason : VARCHAR(500)
    created_at : TIMESTAMP
}

TABLE(order_item) {
    PK(id) : CHAR(36)
    --
    FK(order_id) : CHAR(36)
    FK(product_id) : CHAR(36)
    product_name : VARCHAR(200)
    quantity : INT
    price : DECIMAL(15,2)
    note : VARCHAR(200)
    created_at : TIMESTAMP
}

' =====================================================
' FEEDBACK
' =====================================================
TABLE(feedback) {
    PK(id) : CHAR(36)
    --
    FK(user_id) : CHAR(36)
    FK(product_id) : CHAR(36)
    FK(order_id) : CHAR(36)
    rating : INT
    comment : TEXT
    created_at : TIMESTAMP
}

TABLE(feedback_reply) {
    PK(id) : CHAR(36)
    --
    FK(feedback_id) : CHAR(36)
    FK(user_id) : CHAR(36)
    reply : TEXT
    created_at : TIMESTAMP
}

' =====================================================
' NOTIFICATION
' =====================================================
TABLE(notification) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    FK(user_id) : CHAR(36)
    type : ENUM
    title : VARCHAR(200)
    content : TEXT
    is_read : BOOLEAN
    read_at : TIMESTAMP
    metadata : JSON
    created_at : TIMESTAMP
}

TABLE(system_notification) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    title : VARCHAR(200)
    content : TEXT
    target_role : ENUM
    active_from : TIMESTAMP
    active_to : TIMESTAMP
    is_active : BOOLEAN
    FK(created_by) : CHAR(36)
    created_at : TIMESTAMP
}

TABLE(banner) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    title : VARCHAR(200)
    image_url : VARCHAR(500)
    link_url : VARCHAR(500)
    display_order : INT
    is_active : BOOLEAN
    start_date : TIMESTAMP
    end_date : TIMESTAMP
    FK(created_by) : CHAR(36)
    created_at : TIMESTAMP
}

' =====================================================
' SHIFT & SALARY
' =====================================================
TABLE(shift) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    name : VARCHAR(100)
    start_time : TIME
    end_time : TIME
    day_of_week : JSON
    max_staff : INT
    status : ENUM
    created_at : TIMESTAMP
}

TABLE(staff_shift) {
    PK(id) : CHAR(36)
    --
    FK(shift_id) : CHAR(36)
    FK(staff_id) : CHAR(36)
    FK(canteen_id) : CHAR(36)
    date : DATE
    status : ENUM
    check_in_time : TIMESTAMP
    check_out_time : TIMESTAMP
    actual_work_hours : DECIMAL(5,2)
    notes : VARCHAR(500)
    FK(assigned_by) : CHAR(36)
    created_at : TIMESTAMP
}

TABLE(salary) {
    PK(id) : CHAR(36)
    --
    FK(user_id) : CHAR(36)
    FK(canteen_id) : CHAR(36)
    period_start : DATE
    period_end : DATE
    total_hours : DECIMAL(10,2)
    base_salary : DECIMAL(15,2)
    bonus : DECIMAL(15,2)
    deduction : DECIMAL(15,2)
    total_salary : DECIMAL(15,2)
    status : ENUM
    calculated_at : TIMESTAMP
    paid_at : TIMESTAMP
    note : TEXT
    created_at : TIMESTAMP
}

' =====================================================
' REPORT & AUDIT
' =====================================================
TABLE(report_snapshot) {
    PK(id) : CHAR(36)
    --
    FK(canteen_id) : CHAR(36)
    report_type : ENUM
    report_name : VARCHAR(200)
    period_start : DATE
    period_end : DATE
    data : JSON
    FK(generated_by) : CHAR(36)
    generated_at : TIMESTAMP
    created_at : TIMESTAMP
}

TABLE(audit_log) {
    PK(id) : CHAR(36)
    --
    FK(user_id) : CHAR(36)
    action : VARCHAR(100)
    entity_type : VARCHAR(50)
    entity_id : CHAR(36)
    old_data : JSON
    new_data : JSON
    ip_address : VARCHAR(45)
    user_agent : TEXT
    created_at : TIMESTAMP
}

' =====================================================
' RELATIONSHIPS
' =====================================================
' Campus - Canteen (1:N)
campus ||--o{ canteen : "has"

' Campus - User (1:N)
campus ||--o{ user : "belongs to"

' Canteen - User (1:N) for staff
canteen ||--o{ user : "works at"

' User - Token (1:N)
user ||--o{ token : "has"

' Canteen - Product (1:N)
canteen ||--o{ product : "sells"

' ProductCategory - Product (1:N)
product_category ||--o{ product : "categorizes"

' IngredientCategory - Ingredient (1:N)
ingredient_category ||--o{ ingredient : "categorizes"

' Canteen - Ingredient (1:N)
canteen ||--o{ ingredient : "stores"

' Product - ProductImage (1:N)
product ||--o{ product_image : "has"

' Product - Ingredient (N:M via recipe)
product ||--o{ recipe : "contains"
ingredient ||--o{ recipe : "used in"

' Canteen - Menu (1:N)
canteen ||--o{ menu : "has"

' Menu - MenuItem (1:N)
menu ||--o{ menu_item : "includes"

' Product - MenuItem (1:N)
product ||--o{ menu_item : "listed in"

' Campus - Voucher (1:N)
campus ||--o{ voucher : "scoped to"

' Voucher - VoucherProduct (1:N)
voucher ||--o{ voucher_product : "applies to"
product ||--o{ voucher_product : "discounted by"

' User - Cart (1:N per canteen)
user ||--o{ cart : "owns"
canteen ||--o{ cart : "for"

' Cart - CartItem (1:N)
cart ||--o{ cart_item : "contains"
product ||--o{ cart_item : "in cart"

' User - Wishlist (1:1)
user ||--|| wishlist : "has"

' Wishlist - WishlistItem (1:N)
wishlist ||--o{ wishlist_item : "contains"
product ||--o{ wishlist_item : "favorited"

' User - Order (1:N)
user ||--o{ order : "places"

' Canteen - Order (1:N)
canteen ||--o{ order : "receives"

' User (staff) - Order (1:N)
user ||--o{ order : "handles"

' Voucher - Order (1:N)
voucher ||--o{ order : "used in"

' Order - OrderItem (1:N)
order ||--o{ order_item : "contains"
product ||--o{ order_item : "ordered"

' User - Feedback (1:N)
user ||--o{ feedback : "writes"

' Product - Feedback (1:N)
product ||--o{ feedback : "reviewed"

' Order - Feedback (1:N)
order ||--o{ feedback : "for"

' Feedback - FeedbackReply (1:N)
feedback ||--o{ feedback_reply : "replied"
user ||--o{ feedback_reply : "replies"

' User - Notification (1:N)
user ||--o{ notification : "receives"
canteen ||--o{ notification : "from"

' Canteen - SystemNotification (1:N)
canteen ||--o{ system_notification : "sends"
user ||--o{ system_notification : "creates"

' Canteen - Banner (1:N)
canteen ||--o{ banner : "displays"
user ||--o{ banner : "creates"

' Canteen - Shift (1:N)
canteen ||--o{ shift : "defines"

' Shift - StaffShift (1:N)
shift ||--o{ staff_shift : "scheduled"
user ||--o{ staff_shift : "assigned to"
canteen ||--o{ staff_shift : "at"

' User - Salary (1:N)
user ||--o{ salary : "receives"
canteen ||--o{ salary : "pays"

' Canteen - ReportSnapshot (1:N)
canteen ||--o{ report_snapshot : "generates"
user ||--o{ report_snapshot : "created by"

' User - AuditLog (1:N)
user ||--o{ audit_log : "performed"

@enduml
