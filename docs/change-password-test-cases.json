{
  "_comment": "File này chứa các request mẫu để test API đổi mật khẩu",
  "_instructions": [
    "1. Trước tiên, đăng nhập để lấy token",
    "2. Copy token vào phần Authorization của các request đổi mật khẩu",
    "3. Test từng case một để kiểm tra các tình huống khác nhau"
  ],

  "step1_login": {
    "description": "Đăng nhập để lấy token",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/login",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "email": "user@example.com",
      "password": "oldPassword123"
    },
    "note": "Thay email và password bằng tài khoản thật của bạn. Sau khi đăng nhập, copy token từ response để dùng cho các request tiếp theo"
  },

  "step2_change_password_success": {
    "description": "Test Case 1: Đổi mật khẩu thành công",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_TOKEN_HERE"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "newPassword456",
      "confirmPassword": "newPassword456"
    },
    "expectedStatus": 200,
    "expectedResponse": {
      "status": "success",
      "message": "Đổi mật khẩu thành công"
    }
  },

  "test_case_2_password_mismatch": {
    "description": "Test Case 2: Mật khẩu xác nhận không khớp",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_TOKEN_HERE"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "newPassword456",
      "confirmPassword": "differentPassword789"
    },
    "expectedStatus": 400,
    "expectedResponse": {
      "status": "error",
      "message": "Mật khẩu mới và xác nhận mật khẩu không khớp"
    }
  },

  "test_case_3_wrong_current_password": {
    "description": "Test Case 3: Mật khẩu hiện tại sai",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_TOKEN_HERE"
    },
    "body": {
      "currentPassword": "wrongPassword",
      "newPassword": "newPassword456",
      "confirmPassword": "newPassword456"
    },
    "expectedStatus": 401,
    "expectedResponse": {
      "status": "error",
      "message": "Mật khẩu hiện tại không đúng"
    }
  },

  "test_case_4_same_password": {
    "description": "Test Case 4: Mật khẩu mới trùng với cũ",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_TOKEN_HERE"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "oldPassword123",
      "confirmPassword": "oldPassword123"
    },
    "expectedStatus": 400,
    "expectedResponse": {
      "status": "error",
      "message": "Mật khẩu mới phải khác với mật khẩu hiện tại"
    }
  },

  "test_case_5_password_too_short": {
    "description": "Test Case 5: Mật khẩu quá ngắn",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_TOKEN_HERE"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "123",
      "confirmPassword": "123"
    },
    "expectedStatus": 400,
    "expectedResponse": {
      "status": "error",
      "message": "Mật khẩu mới phải có ít nhất 6 ký tự"
    }
  },

  "test_case_6_missing_fields": {
    "description": "Test Case 6: Thiếu trường bắt buộc",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer YOUR_TOKEN_HERE"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "newPassword456"
    },
    "expectedStatus": 400,
    "expectedResponse": {
      "status": "error",
      "message": "Vui lòng cung cấp đầy đủ mật khẩu hiện tại, mật khẩu mới và xác nhận mật khẩu"
    }
  },

  "test_case_7_no_token": {
    "description": "Test Case 7: Không có token xác thực",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "newPassword456",
      "confirmPassword": "newPassword456"
    },
    "expectedStatus": 401,
    "expectedResponse": {
      "status": "error",
      "message": "You are not logged in. Please log in to access."
    }
  },

  "test_case_8_invalid_token": {
    "description": "Test Case 8: Token không hợp lệ",
    "method": "POST",
    "url": "http://localhost:5000/api/auth/change-password",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer invalid_token_12345"
    },
    "body": {
      "currentPassword": "oldPassword123",
      "newPassword": "newPassword456",
      "confirmPassword": "newPassword456"
    },
    "expectedStatus": 401,
    "note": "Token không hợp lệ sẽ trả về lỗi xác thực"
  }
}
