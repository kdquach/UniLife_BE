@startuml ERD_MODULE_3_ORDER_TRANSACTION
' =====================================================
' Module 3: Order & Transaction - Đơn hàng & Giao dịch
' Bao gồm: cart, cart_item, wishlist, wishlist_item, 
'          order, order_item, voucher, voucher_product
' =====================================================

!define TABLE(name) entity name << (T,#AAAAFF) >>
!define PRIMARY_KEY(x) <b><color:#b8860b><&key></color> x</b>
!define FOREIGN_KEY(x) <color:#aaaaaa><&link-intact></color> x
!define COLUMN(x) <color:#efefef><&media-record></color> x
!define NOT_NULL(x) <u>x</u>

skinparam linetype ortho
skinparam entity {
    BackgroundColor #f5f5ff
    BorderColor #333333
    ArrowColor #333333
}

title Module 3: Order & Transaction - Đơn hàng & Giao dịch\n(cart, cart_item, wishlist, wishlist_item, order, order_item, voucher, voucher_product)

' =====================================================
' REFERENCE TABLES (từ Module khác)
' =====================================================
entity user << (R,#CCCCCC) Reference >> {
    PRIMARY_KEY(id) : CHAR(36)
    --
    full_name : VARCHAR(100)
    .. Xem chi tiết tại Module 1 ..
}

entity canteen << (R,#CCCCCC) Reference >> {
    PRIMARY_KEY(id) : CHAR(36)
    --
    name : VARCHAR(100)
    .. Xem chi tiết tại Module 1 ..
}

entity campus << (R,#CCCCCC) Reference >> {
    PRIMARY_KEY(id) : CHAR(36)
    --
    name : VARCHAR(255)
    .. Xem chi tiết tại Module 1 ..
}

entity product << (R,#CCCCCC) Reference >> {
    PRIMARY_KEY(id) : CHAR(36)
    --
    name : VARCHAR(200)
    price : DECIMAL(15,2)
    .. Xem chi tiết tại Module 2 ..
}

' =====================================================
' BẢNG CART - Giỏ hàng
' =====================================================
TABLE(cart) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(user_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(canteen_id) : CHAR(36) <<FK>>
    total_price : DECIMAL(15,2)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    --
    <<UNIQUE(user_id, canteen_id)>>
}

' =====================================================
' BẢNG CART_ITEM - Chi tiết giỏ hàng
' =====================================================
TABLE(cart_item) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(cart_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(product_id) : CHAR(36) <<FK>>
    NOT_NULL(quantity) : INT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    --
    <<UNIQUE(cart_id, product_id)>>
}

' =====================================================
' BẢNG WISHLIST - Danh sách yêu thích
' =====================================================
TABLE(wishlist) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(user_id) : CHAR(36) <<FK, UNIQUE>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' =====================================================
' BẢNG WISHLIST_ITEM - Chi tiết wishlist
' =====================================================
TABLE(wishlist_item) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(wishlist_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(product_id) : CHAR(36) <<FK>>
    created_at : TIMESTAMP
    --
    <<UNIQUE(wishlist_id, product_id)>>
}

' =====================================================
' BẢNG VOUCHER - Mã giảm giá
' =====================================================
TABLE(voucher) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    NOT_NULL(code) : VARCHAR(20) <<UNIQUE>>
    NOT_NULL(discount_type) : ENUM('percentage', 'fixed')
    NOT_NULL(value) : DECIMAL(15,2)
    min_order_amount : DECIMAL(15,2)
    max_discount : DECIMAL(15,2)
    max_usage : INT
    used_count : INT
    NOT_NULL(start_date) : DATETIME
    NOT_NULL(end_date) : DATETIME
    is_active : BOOLEAN
    FOREIGN_KEY(campus_id) : CHAR(36) <<FK>>
    user_usage_limit : INT
    apply_to : ENUM('all', 'specific_products')
    description : VARCHAR(500)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' =====================================================
' BẢNG VOUCHER_PRODUCT - Sản phẩm áp dụng voucher
' =====================================================
TABLE(voucher_product) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(voucher_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(product_id) : CHAR(36) <<FK>>
    created_at : TIMESTAMP
    --
    <<UNIQUE(voucher_id, product_id)>>
}

' =====================================================
' BẢNG ORDER - Đơn hàng
' =====================================================
TABLE(order) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    NOT_NULL(order_number) : VARCHAR(50) <<UNIQUE>>
    FOREIGN_KEY(user_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(canteen_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(staff_id) : CHAR(36) <<FK>>
    status : ENUM('pending', 'confirmed', 'preparing', 'ready', 'completed', 'cancelled')
    NOT_NULL(sub_total) : DECIMAL(15,2)
    discount : DECIMAL(15,2)
    NOT_NULL(total_amount) : DECIMAL(15,2)
    FOREIGN_KEY(voucher_id) : CHAR(36) <<FK>>
    voucher_code : VARCHAR(20)
    --
    == Payment Info ==
    payment_method : ENUM('cash', 'momo', 'vnpay', 'sepay', 'balance', 'bank_transfer')
    payment_status : ENUM('pending', 'completed', 'failed', 'refunded')
    payment_transaction_id : VARCHAR(100)
    payment_amount : DECIMAL(15,2)
    paid_at : TIMESTAMP
    refund_amount : DECIMAL(15,2)
    refunded_at : TIMESTAMP
    --
    == Pickup QR ==
    pickup_qr_code : VARCHAR(100)
    pickup_qr_expire_at : TIMESTAMP
    pickup_qr_scanned_at : TIMESTAMP
    FOREIGN_KEY(pickup_qr_scanned_by) : CHAR(36) <<FK>>
    --
    == Order Details ==
    note : VARCHAR(500)
    estimated_time : INT
    prepared_at : TIMESTAMP
    completed_at : TIMESTAMP
    cancelled_at : TIMESTAMP
    cancel_reason : VARCHAR(500)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

' =====================================================
' BẢNG ORDER_ITEM - Chi tiết đơn hàng
' =====================================================
TABLE(order_item) {
    PRIMARY_KEY(id) : CHAR(36)
    --
    FOREIGN_KEY(order_id) : CHAR(36) <<FK>>
    FOREIGN_KEY(product_id) : CHAR(36) <<FK>>
    NOT_NULL(product_name) : VARCHAR(200)
    NOT_NULL(quantity) : INT
    NOT_NULL(price) : DECIMAL(15,2)
    note : VARCHAR(200)
    created_at : TIMESTAMP
}

' =====================================================
' MỐI QUAN HỆ
' =====================================================

' User - Cart: 1-N (Một user có thể có nhiều cart theo canteen)
user ||--o{ cart : "1-N: có"

' User - Wishlist: 1-1 (Một user chỉ có một wishlist)
user ||--|| wishlist : "1-1: sở hữu"

' User - Order: 1-N (Một user có nhiều đơn hàng)
user ||--o{ order : "1-N: đặt"

' Canteen - Cart: 1-N
canteen ||--o{ cart : "1-N"

' Canteen - Order: 1-N
canteen ||--o{ order : "1-N: nhận"

' Cart - Cart Item: 1-N
cart ||--o{ cart_item : "1-N: chứa"

' Product - Cart Item: 1-N
product ||--o{ cart_item : "1-N"

' Wishlist - Wishlist Item: 1-N
wishlist ||--o{ wishlist_item : "1-N: chứa"

' Product - Wishlist Item: 1-N
product ||--o{ wishlist_item : "1-N"

' Campus - Voucher: 1-N
campus ||--o{ voucher : "1-N: áp dụng"

' Voucher - Voucher Product: 1-N (N-M với Product)
voucher ||--o{ voucher_product : "1-N"
product ||--o{ voucher_product : "1-N"
note "N-M: Voucher - Product\nqua bảng trung gian" as N2
voucher_product .. N2

' Voucher - Order: 1-N
voucher ||--o{ order : "1-N: sử dụng"

' Order - Order Item: 1-N
order ||--o{ order_item : "1-N: chứa"

' Product - Order Item: 1-N
product ||--o{ order_item : "1-N"

' User (Staff) - Order: 1-N (Staff xử lý order)
user ||--o{ order : "1-N: xử lý (staff)"

@enduml
